# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rental_marketplace?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-in-production-use-different-long-random-string"

# App
NODE_ENV="development"
PORT=3001
API_PREFIX="api/v1"

# Paystack (v1 escrow integration)
PAYSTACK_SECRET_KEY="sk_test_your_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_key_here"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@boroboro.com"
